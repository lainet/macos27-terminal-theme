{
  "name": "macos27-terminal-theme",
  "displayName": "macOS 27 Terminal Theme",
  "description": "A VS Code theme matching the appearance and exact ANSI palette of the macOS 27 Terminal.",
  "version": "1.1.0",
  "publisher": "lainet",
  "license": "MIT",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#161B24",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lainet/macos27-terminal-theme.git"
  },
  "bugs": {
    "url": "https://github.com/lainet/macos27-terminal-theme/issues"
  },
  "homepage": "https://github.com/lainet/macos27-terminal-theme#readme",
  "categories": [
    "Themes"
  ],
  "keywords": [
    "macos",
    "terminal",
    "dark",
    "theme",
    "ansi",
    "slate",
    "retro",
    "apple"
  ],
  "contributes": {
    "themes": [
      {
        "label": "macOS 27 Terminal",
        "uiTheme": "vs-dark",
        "path": "./themes/macos27-terminal.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run validate",
    "validate": "vsce ls",
    "lint": "node scripts/validate-theme.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0"
  }
}
